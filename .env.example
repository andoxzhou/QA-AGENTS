# PostHog analytics — used by the QA dashboard (src/dashboard/server.ts)
# The dashboard injects these into index.html server-side, so the token never
# appears in the committed source. Copy this file to .env and fill in real values.
POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com
